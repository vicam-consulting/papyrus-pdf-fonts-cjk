{
    "name": "vicam/pdf-fonts-cjk",
    "description": "Compatibility umbrella for Vicam PDF Japanese, Simplified/Traditional Chinese and Korean font packs.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vicam/pdf": "^0.4.0",
        "vicam/pdf-fonts-ja": "^0.2.0",
        "vicam/pdf-fonts-zh-hans": "^0.2.0",
        "vicam/pdf-fonts-zh-hant": "^0.2.0",
        "vicam/pdf-fonts-ko": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Vicam\\Pdf\\FontsCjk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vicam\\Pdf\\FontsCjk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
