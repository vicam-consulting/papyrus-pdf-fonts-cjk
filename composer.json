{
    "name": "vicam/papyrus-pdf-fonts-cjk",
    "description": "Static Noto Sans and Serif JP, SC and KR fonts for PapyrusPDF form appearances and overlays.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vicam/papyrus-pdf": "^0.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "PapyrusPDF\\FontsCjk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapyrusPDF\\FontsCjk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
