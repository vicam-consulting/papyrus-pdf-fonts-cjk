{
    "name": "vicam/papyrus-pdf-fonts-cjk",
    "description": "Compatibility umbrella for PapyrusPDF Japanese, Simplified/Traditional Chinese and Korean font packs.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vicam/papyrus-pdf": "^0.3.4",
        "vicam/papyrus-pdf-fonts-ja": "^0.1.0",
        "vicam/papyrus-pdf-fonts-zh-hans": "^0.1.0",
        "vicam/papyrus-pdf-fonts-zh-hant": "^0.1.0",
        "vicam/papyrus-pdf-fonts-ko": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "PapyrusPDF\\FontsCjk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapyrusPDF\\FontsCjk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
